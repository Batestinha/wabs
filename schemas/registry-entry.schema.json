{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batestinha.github.io/wabs/schemas/registry-entry.schema.json",
  "title": "WABS Registry Plugin Entry",
  "type": "object",
  "required": [
    "pluginId",
    "name",
    "description",
    "author",
    "trust",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
    },
    "supersededBy": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$",
      "description": "Current replacement plugin ID. Published versions retain their original metadata and archives."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(?:.*\\S)?$",
      "not": {
        "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "description": "The title the plugin declares in wa-plugin.json (schemaVersion 2). Never a plugin ID."
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "The author the plugin declares in wa-plugin.json (schemaVersion 2).",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "official",
        "verified",
        "local-dev",
        "unsafe"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "homepageUrl": {
      "type": "string",
      "format": "uri"
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "changelogUrl": {
      "type": "string",
      "format": "uri"
    },
    "supportUrl": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "iconUrl": {
      "type": "string",
      "format": "uri"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "privacyNotes": {
      "type": "string",
      "minLength": 1
    },
    "dataStored": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "networkAccess": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configUiSchema": {},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "coreApiRange",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "coreApiRange": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "kind",
              "uri"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "directory",
                  "archive",
                  "npm",
                  "git"
                ]
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "packageName": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "eventSubscriptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "requiredPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "labelKey",
                "descriptionKey",
                "permissions"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "labelKey": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "descriptionKey": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          },
          "requiredBotCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "dangerousActions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "backgroundJobs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pluginId",
                "versionRange"
              ],
              "additionalProperties": false,
              "properties": {
                "pluginId": {
                  "type": "string",
                  "minLength": 1
                },
                "versionRange": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                },
                "feature": {
                  "$ref": "#/$defs/featureSettings"
                }
              }
            },
            "default": []
          },
          "integrations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pluginId",
                "versionRange",
                "description"
              ],
              "properties": {
                "pluginId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
                },
                "versionRange": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 280
                },
                "feature": {
                  "$ref": "#/$defs/featureSettings"
                }
              }
            }
          },
          "dataVersion": {
            "type": "string",
            "minLength": 1
          },
          "backgroundJobAvailability": {
            "enum": [
              "enabled",
              "installed"
            ]
          },
          "scopeClock": {
            "type": "object",
            "properties": {
              "timezoneConfigPaths": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*$",
                  "not": {
                    "pattern": "(^|\\.)(__proto__|prototype|constructor)($|\\.)"
                  }
                }
              },
              "providesGroupTimezones": {
                "type": "boolean"
              }
            },
            "required": [
              "timezoneConfigPaths"
            ],
            "additionalProperties": false
          },
          "configuration": {
            "type": "object",
            "properties": {
              "configuredMessages": {
                "type": "boolean"
              },
              "localizedText": {
                "type": "boolean"
              },
              "changedActionId": {
                "type": "string",
                "minLength": 1
              },
              "scopeEnabledOperationId": {
                "type": "string",
                "minLength": 1
              },
              "permissionDeclarations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "arrayPath": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                    },
                    "prefix": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9.-]*\\.$"
                    },
                    "valuePaths": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                      }
                    }
                  },
                  "required": [
                    "arrayPath",
                    "prefix",
                    "valuePaths"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "consoleOperations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operationId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(?:\\.[A-Za-z][A-Za-z0-9-]*)+$"
                },
                "access": {
                  "enum": [
                    "read",
                    "mutation"
                  ]
                },
                "authorization": {
                  "enum": [
                    "operator",
                    "resource-token"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operationId",
                "access",
                "authorization",
                "description"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "authorization": {
                        "const": "resource-token"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "access": {
                        "const": "read"
                      }
                    }
                  }
                }
              ]
            }
          },
          "externalActions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actionId": {
                  "type": "string",
                  "minLength": 1
                },
                "access": {
                  "enum": [
                    "read",
                    "mutation"
                  ]
                },
                "scope": {
                  "enum": [
                    "account",
                    "scope"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "actionId",
                "access",
                "scope"
              ],
              "additionalProperties": false
            }
          },
          "cancellation": {
            "type": "object",
            "properties": {
              "workflows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "workflows"
            ],
            "additionalProperties": false
          },
          "databases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "engine": {
                  "const": "sqlite"
                },
                "scope": {
                  "const": "account"
                },
                "migrations": {
                  "type": "string",
                  "minLength": 1
                },
                "operatorMigrations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "name",
                "engine",
                "scope",
                "migrations"
              ],
              "additionalProperties": false
            }
          },
          "ownedData": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "resource"
              ],
              "additionalProperties": false
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serviceId": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "methods": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "access": {
                        "enum": [
                          "read",
                          "mutation"
                        ]
                      },
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "availability": {
                        "enum": [
                          "enabled",
                          "installed"
                        ]
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      },
                      "requiredPermissions": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "assistantRead": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "descriptionKey",
                          "allowScopeMembers"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9.-]{1,62}$"
                          },
                          "descriptionKey": {
                            "type": "string",
                            "minLength": 1
                          },
                          "allowScopeMembers": {
                            "type": "boolean"
                          },
                          "membership": {
                            "enum": [
                              "effective_scope",
                              "current_group"
                            ]
                          }
                        }
                      }
                    },
                    "required": [
                      "name",
                      "access"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "availability"
                          ],
                          "properties": {
                            "availability": {
                              "const": "installed"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "access": {
                              "const": "read"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "serviceId",
                "methods"
              ],
              "additionalProperties": false
            }
          },
          "workflowActions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "operatorConsole": {
            "type": "object",
            "properties": {
              "configPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "internalConfigPaths": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "settings": {
                "type": "object",
                "properties": {
                  "sections": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "controlIds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "controlIds"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "routeAliases": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^/[^/]"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [
                  "sections"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "assistant": {
            "type": "object"
          },
          "help": {
            "type": "object"
          },
          "workspaceCapabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "capabilityId"
              ],
              "properties": {
                "capabilityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-z][a-z0-9._-]*$"
                },
                "commands": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^/[a-z][a-z0-9-]*$"
                  }
                },
                "triggers": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[a-z][a-z0-9._-]*$"
                  }
                },
                "enabledSetting": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "triggerSetting": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                },
                "announcementSetting": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                }
              }
            }
          },
          "memberSubscriptions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "labelKey": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 220
                    },
                    "serviceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "enum": [
                        "current",
                        "community"
                      ]
                    },
                    "kind": {
                      "const": "internal"
                    },
                    "booleanSetting": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 12,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9-]{0,63}$"
                          },
                          "labelKey": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 220
                          }
                        },
                        "required": [
                          "id",
                          "labelKey"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "labelKey",
                    "serviceId",
                    "scope",
                    "kind",
                    "choices"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    },
                    "labelKey": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 220
                    },
                    "serviceId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "enum": [
                        "current",
                        "community"
                      ]
                    },
                    "kind": {
                      "const": "external"
                    }
                  },
                  "required": [
                    "id",
                    "labelKey",
                    "serviceId",
                    "scope",
                    "kind"
                  ]
                }
              ]
            }
          },
          "operationPermissions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "action",
                "title",
                "description",
                "defaultAccess"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]+$",
                  "maxLength": 128
                },
                "action": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "defaultAccess": {
                  "enum": [
                    "scope-member",
                    "bot-admin",
                    "resource-visibility",
                    "explicit"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "repository": {
      "type": "string",
      "format": "uri"
    }
  },
  "$defs": {
    "featureSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "consumer",
        "settingsOwner",
        "controlIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]+$",
          "maxLength": 120
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "settingsOwner": {
          "type": "string",
          "minLength": 1
        },
        "controlIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "shared": {
          "type": "boolean"
        }
      }
    }
  }
}
