{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batestinha.github.io/wabs/schemas/registry-entry.schema.json",
  "title": "WABS Registry Plugin Entry",
  "type": "object",
  "required": [
    "pluginId",
    "name",
    "description",
    "trust",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "trust": {
      "type": "string",
      "enum": [
        "official",
        "verified",
        "local-dev",
        "unsafe"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "homepageUrl": {
      "type": "string",
      "format": "uri"
    },
    "docsUrl": {
      "type": "string",
      "format": "uri"
    },
    "changelogUrl": {
      "type": "string",
      "format": "uri"
    },
    "supportUrl": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "iconUrl": {
      "type": "string",
      "format": "uri"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "privacyNotes": {
      "type": "string",
      "minLength": 1
    },
    "dataStored": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "networkAccess": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configUiSchema": {},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "coreApiRange",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "coreApiRange": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": [
              "kind",
              "uri"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "directory",
                  "archive",
                  "npm",
                  "git"
                ]
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "packageName": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "eventSubscriptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "requiredPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "requiredBotCapabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "dangerousActions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "backgroundJobs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": []
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pluginId",
                "versionRange"
              ],
              "additionalProperties": false,
              "properties": {
                "pluginId": {
                  "type": "string",
                  "minLength": 1
                },
                "versionRange": {
                  "type": "string",
                  "minLength": 1
                },
                "optional": {
                  "type": "boolean"
                }
              }
            },
            "default": []
          },
          "dataVersion": {
            "type": "string",
            "minLength": 1
          },
          "backgroundJobAvailability": {
            "enum": [
              "enabled",
              "installed"
            ]
          },
          "scopeClock": {
            "type": "object",
            "properties": {
              "timezoneConfigPaths": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*$",
                  "not": {
                    "pattern": "(^|\\.)(__proto__|prototype|constructor)($|\\.)"
                  }
                }
              },
              "providesGroupTimezones": {
                "type": "boolean"
              }
            },
            "required": [
              "timezoneConfigPaths"
            ],
            "additionalProperties": false
          },
          "configuration": {
            "type": "object",
            "properties": {
              "changedActionId": {
                "type": "string",
                "minLength": 1
              },
              "scopeEnabledOperationId": {
                "type": "string",
                "minLength": 1
              },
              "permissionDeclarations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "arrayPath": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                    },
                    "prefix": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9.-]*\\.$"
                    },
                    "valuePaths": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$"
                      }
                    }
                  },
                  "required": [
                    "arrayPath",
                    "prefix",
                    "valuePaths"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "consoleOperations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operationId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*(?:\\.[A-Za-z][A-Za-z0-9-]*)+$"
                },
                "access": {
                  "enum": [
                    "read",
                    "mutation"
                  ]
                },
                "authorization": {
                  "enum": [
                    "operator",
                    "resource-token"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "operationId",
                "access",
                "authorization",
                "description"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "authorization": {
                        "const": "resource-token"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "access": {
                        "const": "read"
                      }
                    }
                  }
                }
              ]
            }
          },
          "externalActions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "actionId": {
                  "type": "string",
                  "minLength": 1
                },
                "access": {
                  "enum": [
                    "read",
                    "mutation"
                  ]
                },
                "scope": {
                  "enum": [
                    "account",
                    "scope"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "actionId",
                "access",
                "scope"
              ],
              "additionalProperties": false
            }
          },
          "cancellation": {
            "type": "object",
            "properties": {
              "workflows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "workflows"
            ],
            "additionalProperties": false
          },
          "databases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "engine": {
                  "const": "sqlite"
                },
                "scope": {
                  "const": "account"
                },
                "migrations": {
                  "type": "string",
                  "minLength": 1
                },
                "operatorMigrations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "name",
                "engine",
                "scope",
                "migrations"
              ],
              "additionalProperties": false
            }
          },
          "ownedData": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "resource": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "resource"
              ],
              "additionalProperties": false
            }
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "serviceId": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "methods": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "access": {
                        "enum": [
                          "read",
                          "mutation"
                        ]
                      },
                      "timeoutMs": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "availability": {
                        "enum": [
                          "enabled",
                          "installed"
                        ]
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      },
                      "requiredPermissions": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "name",
                      "access"
                    ],
                    "additionalProperties": false,
                    "allOf": [
                      {
                        "if": {
                          "required": [
                            "availability"
                          ],
                          "properties": {
                            "availability": {
                              "const": "installed"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "access": {
                              "const": "read"
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "serviceId",
                "methods"
              ],
              "additionalProperties": false
            }
          },
          "workflowActions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "operatorConsole": {
            "type": "object",
            "properties": {
              "configPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "internalConfigPaths": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            },
            "required": [],
            "additionalProperties": true
          },
          "assistant": {
            "type": "object"
          },
          "help": {
            "type": "object"
          }
        }
      }
    },
    "repository": {
      "type": "string",
      "format": "uri"
    }
  }
}
