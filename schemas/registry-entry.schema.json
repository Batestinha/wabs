{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batestinha.github.io/wabs/schemas/registry-entry.schema.json",
  "title": "WABS Registry Plugin Entry",
  "type": "object",
  "required": ["pluginId", "name", "description", "trust", "versions"],
  "additionalProperties": false,
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "trust": {
      "type": "string",
      "enum": ["official", "verified", "local-dev", "unsafe"]
    },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "homepageUrl": { "type": "string", "format": "uri" },
    "docsUrl": { "type": "string", "format": "uri" },
    "changelogUrl": { "type": "string", "format": "uri" },
    "supportUrl": { "type": "string", "format": "uri" },
    "license": { "type": "string", "minLength": 1 },
    "iconUrl": { "type": "string", "format": "uri" },
    "screenshots": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "privacyNotes": { "type": "string", "minLength": 1 },
    "dataStored": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "networkAccess": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "configUiSchema": {},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "coreApiRange", "source"],
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
          },
          "coreApiRange": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "required": ["kind", "uri"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["directory", "archive", "signed_bundle", "npm", "git"]
              },
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "packageName": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "signature": {
            "type": "object",
            "required": ["algorithm", "keyId", "signature"],
            "additionalProperties": false,
            "properties": {
              "algorithm": { "const": "ed25519" },
              "keyId": { "type": "string", "minLength": 1 },
              "signature": { "type": "string", "minLength": 1 }
            }
          },
          "commands": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "eventSubscriptions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "requiredPermissions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "requiredBotCapabilities": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "dangerousActions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "backgroundJobs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pluginId", "versionRange"],
              "additionalProperties": false,
              "properties": {
                "pluginId": { "type": "string", "minLength": 1 },
                "versionRange": { "type": "string", "minLength": 1 },
                "optional": { "type": "boolean" }
              }
            },
            "default": []
          }
        }
      }
    }
  }
}
