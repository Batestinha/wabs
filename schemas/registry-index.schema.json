{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batestinha.github.io/wabs/schemas/registry-index.schema.json",
  "title": "WABS Registry Index",
  "type": "object",
  "required": ["schemaVersion", "registryName", "generatedAt", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "registryName": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "registry-entry.schema.json" }
    }
  }
}
