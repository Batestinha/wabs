{
  "pluginId": "official.onboarding",
  "name": "Onboarding",
  "description": "Welcome people once, on their first arrival in a community or group: rules, a guide built from /help, and an optional account invitation.",
  "author": {
    "name": "Batestinha",
    "url": "https://github.com/Batestinha"
  },
  "trust": "official",
  "category": "community",
  "tags": [
    "onboarding",
    "welcome",
    "rules",
    "newcomers",
    "managed-groups"
  ],
  "dataStored": [
    "Account-scoped SQLite database: one row per person and scope (when they were first seen, welcomed, or left the scope), the per-scope seeding marker, and the one-time late-welcome queue with its prepared messages."
  ],
  "homepageUrl": "https://github.com/Batestinha/wabp-plugin-onboarding",
  "docsUrl": "https://github.com/Batestinha/wabp-plugin-onboarding#readme",
  "changelogUrl": "https://github.com/Batestinha/wabp-plugin-onboarding/releases",
  "supportUrl": "https://github.com/Batestinha/wabp-plugin-onboarding/issues",
  "license": "MIT",
  "privacyNotes": "Runs through WABP host capabilities and uses no external HTTP provider. Welcomes go privately to the newcomer; the account invitation is skipped for identities that already have a linked sign-in account.",
  "repository": "https://github.com/Batestinha/wabp-plugin-onboarding",
  "versions": [
