{
  "pluginId": "official.community-subgroups",
  "name": "Community Subgroups",
  "description": "Member-facing community subgroup creation and subgroup profile controls.",
  "trust": "official",
  "category": "community",
  "tags": [
    "community",
    "subgroups",
    "moderation"
  ],
  "versions": [
    {
      "version": "0.1.1",
      "coreApiRange": "^0.3.0",
      "source": {
        "kind": "signed_bundle",
        "uri": "https://github.com/Batestinha/wabp-plugin-community-subgroups/releases/download/v0.1.1/official.community-subgroups-0.1.1.tgz"
      },
      "commands": [
        "/subgroup create",
        "/title",
        "/description",
        "/pin",
        "/unpin"
      ],
      "eventSubscriptions": [],
      "services": [
        {
          "serviceId": "official.community-subgroups.v1",
          "methods": [
            {
              "name": "createManagedSubgroupCandidate",
              "access": "mutation",
              "timeoutMs": 120000
            },
            {
              "name": "reconcileManagedSubgroupCreator",
              "access": "mutation",
              "timeoutMs": 120000
            },
            {
              "name": "configureManagedSubgroup",
              "access": "mutation",
              "timeoutMs": 120000
            },
            {
              "name": "completeManagedSubgroup",
              "access": "mutation",
              "timeoutMs": 120000
            }
          ]
        }
      ],
      "requiredPermissions": [],
      "requiredBotCapabilities": [],
      "dangerousActions": [
        "group.setSubject",
        "group.setDescription",
        "message.pin",
        "message.unpin"
      ],
      "backgroundJobs": [],
      "cancellation": {
        "workflows": [
          {
            "id": "subgroup-create",
            "description": "Guided subgroup creation before the managed group is created.",
            "mode": "core-flow",
            "scope": "actor-chat",
            "commands": [
              "/subgroup create"
            ],
            "cancellableStates": [
              "active"
            ],
            "terminalStates": [
              "completed",
              "cancelled",
              "expired"
            ],
            "effects": [
              "discard-subgroup-draft"
            ]
          },
          {
            "id": "pin-duration",
            "description": "Guided pin-duration choice before a quoted message is pinned.",
            "mode": "core-flow",
            "scope": "actor-chat",
            "commands": [
              "/pin"
            ],
            "cancellableStates": [
              "active"
            ],
            "terminalStates": [
              "completed",
              "cancelled",
              "expired"
            ],
            "effects": [
              "discard-pin-draft"
            ]
          }
        ]
      },
      "dependencies": [],
      "operatorConsole": {
        "configPaths": [
          "enabled",
          "maxParticipants",
          "creationPolicy.infoEditPermission",
          "creationPolicy.sendMessagesPermission",
          "creationPolicy.memberAddPermission",
          "creationPolicy.joinApproval",
          "creationPolicy.disappearingMessages",
          "creationPolicy.parentGroupCreatePermission",
          "creationPolicy.parentMemberAddPermission"
        ],
        "controls": [
          {
            "id": "plugin.official.community-subgroups.enabled",
            "path": "enabled",
            "label": "Enabled",
            "description": "Allow members to create and manage community subgroups through the bot.",
            "section": "Community subgroups",
            "order": 10,
            "schema": {
              "type": "boolean"
            },
            "ui": {
              "widget": "toggle",
              "helpText": "Allow members to create and manage community subgroups through the bot."
            }
          },
          {
            "id": "plugin.official.community-subgroups.maxParticipants",
            "path": "maxParticipants",
            "label": "Maximum members",
            "description": "Maximum number of requested members in one subgroup creation flow.",
            "section": "Community subgroups",
            "order": 30,
            "schema": {
              "type": "number",
              "unit": "items",
              "min": 1,
              "max": 256
