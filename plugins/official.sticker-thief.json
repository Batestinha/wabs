  },
  "homepageUrl": "https://github.com/Batestinha/wabp-plugin-sticker-thief",
  "docsUrl": "https://github.com/Batestinha/wabp-plugin-sticker-thief#readme",
  "changelogUrl": "https://github.com/Batestinha/wabp-plugin-sticker-thief/releases",
  "supportUrl": "https://github.com/Batestinha/wabp-plugin-sticker-thief/issues",
  "license": "MIT",
  "privacyNotes": "Runs through WABP host capabilities and uses no external HTTP provider. Stickers shared in a group are redistributed privately only to current members of that same scope; admins can remove a sticker permanently with /stickers forget.",
  "repository": "https://github.com/Batestinha/wabp-plugin-sticker-thief"
}
