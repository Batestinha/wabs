{
  "pluginId": "official.sticker-thief",
  "name": "Sticker Thief",
  "description": "Collect new WhatsApp stickers from managed groups and send them privately to subscribed members.",
  "trust": "official",
  "category": "media",
  "tags": [
    "stickers",
    "media",
    "subscriptions"
  ],
  "dataStored": [
    "Collected sticker files (WebP) in the WABP plugin media store, stored once by SHA-256.",
    "Account-scoped SQLite database: which scopes saw each sticker, quoted-message stanza ids for removal, removed-sticker blocks, member subscriptions (cadence, next delivery) and per-member delivery history, and per-chat chat-archive backfill progress (archive media-id cursor, imported count)."
  ],
  "versions": [
    {
      "version": "0.1.0",
