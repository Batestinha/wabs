{
  "pluginId": "official.piwigo-gallery",
  "name": "Piwigo Gallery",
  "description": "WhatsApp document upload workflow for managed Piwigo galleries, with optional community-event album sources.",
  "trust": "official",
  "category": "media",
  "tags": [
    "gallery",
    "piwigo",
    "media"
  ],
  "versions": [
    {
      "version": "0.17.2",
      "coreApiRange": "^0.3.0",
      "source": {
        "kind": "signed_bundle",
        "uri": "https://github.com/Batestinha/wabp-plugin-piwigo-gallery/releases/download/v0.17.2/official.piwigo-gallery-0.17.2.tgz"
      },
      "commands": [
        "/gallery status",
        "/gallery configure",
        "/gallery upload"
      ],
      "eventSubscriptions": [
        "message",
        "private.message",
        "plugin.job"
      ],
      "requiredPermissions": [
        "piwigo-gallery.configure",
        "piwigo-gallery.upload"
      ],
      "requiredBotCapabilities": [],
      "dangerousActions": [],
      "backgroundJobs": [
        "piwigo-gallery.finalize",
        "piwigo-gallery.announce-new-album",
        "piwigo-gallery.media-dump-hint"
      ],
      "externalActions": [
        {
          "actionId": "piwigo.albumUploadObserved",
          "access": "mutation",
          "scope": "scope",
          "description": "Observe a scoped Piwigo album upload and schedule its WhatsApp announcement.",
          "timeoutMs": 30000
        }
      ],
      "databases": [
        {
          "name": "gallery",
          "engine": "sqlite",
          "scope": "account",
          "migrations": "migrations/gallery",
          "operatorMigrations": [
            "011_topomare_subject_cutover.sql"
          ]
        }
      ],
      "dataVersion": "11",
      "cancellation": {
        "workflows": [
          {
            "id": "gallery-upload-setup",
            "description": "Guided gallery upload setup before document collection starts.",
            "mode": "core-flow",
            "scope": "actor-chat",
            "commands": [
              "/gallery upload"
            ],
            "cancellableStates": [
              "active"
            ],
            "terminalStates": [
              "completed",
              "cancelled",
              "expired"
            ],
            "effects": [
              "discard-gallery-upload-draft"
            ]
          },
          {
            "id": "gallery-upload-batch",
            "description": "Active gallery document collection or upload batch.",
            "mode": "plugin-handler",
            "scope": "actor-chat",
            "commands": [
              "/gallery upload"
            ],
            "cancellableStates": [
              "collecting"
            ],
            "terminalStates": [
              "completed",
              "cancelled",
              "expired",
              "failed"
            ],
            "effects": [
              "delete-staged-media",
              "clear-active-batch"
            ],
            "auditAction": "piwigo-gallery.upload.cancel"
          }
        ]
      },
      "dependencies": [
        {
          "pluginId": "official.community-events",
          "versionRange": ">=0.5.0",
          "optional": true
        }
      ],
      "operatorConsole": {
        "configPaths": [
          "enabled",
          "access.allowScopeMemberUploads",
          "autoFinalizeMinutes",
          "maxFileBytes",
          "mediaDumpDocumentsHint",
          "newAlbumAnnouncementsEnabled",
          "announcementGroupWid",
          "newAlbumAnnouncementTemplate",
          "newAlbumAnnouncementDelayMinutes"
        ],
        "controls": [
          {
            "id": "plugin.official.piwigo-gallery.enabled",
            "path": "enabled",
            "label": "Enabled",
            "description": "Enable Piwigo gallery uploads in this scope.",
            "section": "Piwigo Gallery",
            "order": 10,
            "schema": {
              "type": "boolean"
            },
            "ui": {
              "widget": "toggle",
              "helpText": "Enable Piwigo gallery uploads in this scope."
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.access.allowScopeMemberUploads",
            "path": "access.allowScopeMemberUploads",
            "label": "Gallery upload access",
            "description": "Manage who may upload to the Piwigo gallery in this scope.",
            "section": "Piwigo Gallery",
            "order": 30,
            "schema": {
              "type": "boolean"
            },
            "ui": {
              "widget": "builder",
              "builderId": "official.piwigo-gallery.access.v1",
              "helpText": "Manage who may upload to the Piwigo gallery in this scope."
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.autoFinalizeMinutes",
            "path": "autoFinalizeMinutes",
            "label": "Auto-finalize minutes",
            "description": "Minutes after the last accepted document before a gallery upload is finalized automatically.",
            "section": "Piwigo Gallery",
            "order": 40,
            "schema": {
              "type": "number",
              "min": 1,
              "max": 1440
            },
            "ui": {
              "widget": "number",
              "helpText": "Minutes after the last accepted document before a gallery upload is finalized automatically."
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.maxFileBytes",
            "path": "maxFileBytes",
            "label": "Max file size",
            "description": "Optional WhatsApp document size cap for gallery uploads. Set 0 for no plugin-specific limit.",
            "section": "Piwigo Gallery",
            "order": 50,
            "schema": {
              "type": "number",
              "unit": "bytes",
              "min": 0,
              "max": 26843545600
            },
            "ui": {
              "widget": "number",
              "helpText": "Set 0 to rely on WhatsApp, available storage, and the gallery server without an additional plugin cap."
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.mediaDumpDocumentsHint",
            "path": "mediaDumpDocumentsHint",
            "label": "Media dump hint",
            "description": "Optional quote-reply text sent when WhatsApp photos/videos arrive as a media dump.",
            "section": "Piwigo Gallery",
            "order": 60,
            "schema": {
              "type": "string",
              "max": 500
            },
            "ui": {
              "widget": "text",
              "helpText": "Custom WhatsApp reply for media-dump albums. Leave empty to use the default localized message: If you send those files as documents instead of as media (preserves quality), I can upload them directly to the gallery for you.",
              "placeholder": "If you send those files as documents instead of as media (preserves quality), I can upload them directly to the gallery for you.",
              "multiline": true,
              "templateDialect": "conditional-presence-v1",
              "templateActivation": "when-used",
              "templateVariables": [
                {
                  "token": "actorDisplayName",
                  "label": "Sender display name",
                  "sampleValue": "Diogo"
                }
              ],
              "templateConditionVariables": [
                {
                  "token": "actorDisplayName",
                  "label": "Sender display name",
                  "sampleValue": "Diogo"
                },
                {
                  "token": "isGroup",
                  "label": "Group chat",
                  "sampleValue": "true"
                },
                {
                  "token": "isPrivate",
                  "label": "Private chat",
                  "sampleValue": "true"
                }
              ],
              "templateEmptyResult": "suppress"
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.newAlbumAnnouncementsEnabled",
            "path": "newAlbumAnnouncementsEnabled",
            "label": "New album announcements",
            "description": "Announce newly populated Piwigo albums to a WhatsApp group.",
            "section": "Piwigo Gallery",
            "order": 70,
            "schema": {
              "type": "boolean"
            },
            "ui": {
              "widget": "toggle",
              "helpText": "Announce newly populated Piwigo albums to a WhatsApp group."
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.announcementGroupWid",
            "path": "announcementGroupWid",
            "label": "Announcement group",
            "description": "WhatsApp group JID inside this scope where new album announcements are sent.",
            "section": "Piwigo Gallery",
            "order": 80,
            "schema": {
              "type": "string"
            },
            "ui": {
              "widget": "entity-picker",
              "label": "Group",
              "helpText": "WhatsApp group inside this scope that receives new-album announcements. Community scopes default to their WhatsApp announcement group when one is known.",
              "placeholder": "Select announcement group"
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.newAlbumAnnouncementTemplate",
            "path": "newAlbumAnnouncementTemplate",
            "label": "Announcement text",
            "description": "Optional WhatsApp caption template for a new album announcement.",
            "section": "Piwigo Gallery",
            "order": 90,
            "schema": {
              "type": "string",
              "max": 500
            },
            "ui": {
              "widget": "text",
              "label": "Announcement template",
              "helpText": "Use {album}, {site}, and {user}. Leave empty to use the localized message for the scope.",
              "placeholder": "New album {album} added to {site} by {user}.",
              "multiline": true,
              "templateDialect": "conditional-presence-v1",
              "templateActivation": "when-condition-used",
              "templateVariables": [
                {
                  "token": "album",
                  "label": "Album name",
                  "sampleValue": "Summer Walk"
                },
                {
                  "token": "site",
                  "label": "Gallery site",
                  "sampleValue": "Community Gallery"
                },
                {
                  "token": "user",
                  "label": "Uploader",
                  "sampleValue": "Diogo"
                }
              ],
              "templateConditionVariables": [
                {
                  "token": "album",
                  "label": "Album name",
                  "sampleValue": "Summer Walk"
                },
                {
                  "token": "site",
                  "label": "Gallery site",
                  "sampleValue": "Community Gallery"
                },
                {
                  "token": "user",
                  "label": "Uploader",
                  "sampleValue": "Diogo"
                }
              ],
              "templateEmptyResult": "suppress"
            }
          },
          {
            "id": "plugin.official.piwigo-gallery.newAlbumAnnouncementDelayMinutes",
            "path": "newAlbumAnnouncementDelayMinutes",
            "label": "Announcement delay minutes",
            "description": "Minutes after Piwigo reports a new album upload before the WhatsApp album announcement is sent.",
            "section": "Piwigo Gallery",
            "order": 100,
            "schema": {
              "type": "number",
              "min": 1,
              "max": 1440,
              "unit": "minutes"
            },
            "ui": {
              "widget": "number",
              "helpText": "Minutes after Piwigo reports a new album upload before the WhatsApp album announcement is sent."
            }
          }
        ],
        "internalConfigPaths": []
      },
      "checksumSha256": "967b4647de21165527794a7b02e0c06ae7824bcaa3a7ac77a1246ce9e2106d98",
      "signature": {
        "algorithm": "ed25519",
        "keyId": "wabs-official-2026-09",
        "signature": "/pSw0457V02q4pRa3+VEF35WiGIb2N6SPW2O+PN0oR2dsFwSGH5V/qDSTHs0YseHEDXGJY4YmsviiCKLYz9wDQ=="
      }
    }
  ],
  "repository": "https://github.com/Batestinha/wabp-plugin-piwigo-gallery"
}
